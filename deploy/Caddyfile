# AutoOffice3D — Caddy vhost office stack LOKAL (Fase 10/12).
#
#   http://office.localhost  → Theater (HUD) + jalur Brain yang dibutuhkan
#                              browser: /brain-server (socket), /widget/*,
#                              /cs/contracts/*, /demo/*, /health.
#   http://cs.localhost      → kanal publik CS: widget + kontrak + socket
#                              (aksi operator tetap ditolak Brain tanpa token).
#
# Port Brain tidak dipublish di compose — semua akses lewat Caddy.
# Versi VPS (TLS otomatis + basic auth + wildcard demo) ada di Caddyfile.vps.
{
	admin off
	auto_https off
}

http://{$OFFICE_DOMAIN:office.localhost} {
	@brain path /brain-server* /widget/* /cs/contracts/* /demo/* /health
	handle @brain {
		reverse_proxy brain:4800
	}
	handle {
		reverse_proxy theater:3000
	}
}

http://{$CS_DOMAIN:cs.localhost} {
	reverse_proxy brain:4800
}

# Wildcard demo lokal tidak dipakai — instance demo diakses lewat mapping port
# host (http://localhost:4510+). Di VPS, subdomain demo dibuat otomatis oleh
# caddy-docker-proxy dari label `caddy=` yang dipasang Brain (Caddyfile.vps).
