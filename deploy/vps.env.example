# AutoOffice3D — .env VPS (PRD §7 Fase 12)
#
#   cp deploy/vps.env.example .env
#   docker compose -f docker-compose.yml -f docker-compose.vps.yml up -d --build
#
# Jangan commit file `.env` (sudah di .gitignore).

# ── Domain & TLS (DNS A record → IP VPS; port 80/443 terbuka) ───────────
OFFICE_DOMAIN=office.example.com
CS_DOMAIN=cs.example.com
# Wildcard DNS: *.demo.example.com → IP VPS (Let's Encrypt per-host).
DEMO_BASE_DOMAIN=demo.example.com
ACME_EMAIL=founder@example.com

# ── Auth (PRD §6.5) ─────────────────────────────────────────────────────
# Basic auth Theater: "user hash-bcrypt". Generate:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'password-panjang'
# Bungkus dengan kutip tunggal agar `$` pada hash tidak diinterpolasi compose.
OFFICE_BASIC_AUTH='founder $2a$14$GANTI_DENGAN_HASH_BCRYPT'
# Token operator Brain (openssl rand -hex 32) — disuntik Caddy ke socket.
BRAIN_AUTH_TOKEN=GANTI_DENGAN_TOKEN_ACAK_PANJANG

# ── LLM: 9router (internal) atau API resmi ──────────────────────────────
# Fallback resmi: hapus ANTHROPIC_BASE_URL & isi ANTHROPIC_API_KEY langsung.
LLM_DRIVER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=http://9router:20128/v1
MODEL=claude-3-5-sonnet-latest

# 9router (dashboard TIDAK diekspos publik — akses via SSH tunnel).
NINE_ROUTER_REQUIRE_API_KEY=true
NINE_ROUTER_INITIAL_PASSWORD=GANTI_PASSWORD_DASHBOARD
# API key dibuat sekali di dashboard (Proxies → API Keys), lalu dipakai:
#   docker compose exec brain node scripts/check-9router.mjs \
#     --url http://9router:20128 --key 9r_xxx --model <id-model>
NINE_ROUTER_API_KEY=9r_xxx

# ── Observability & notifikasi ──────────────────────────────────────────
LOG_LEVEL=info
NOTIFY_DRIVER=auto
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── CS Agent (widget publik di CS_DOMAIN) ───────────────────────────────
CS_PUBLIC_BASE_URL=https://cs.example.com
CS_WIDGET_URL=https://cs.example.com
# WHATSAPP_DRIVER=live + 3 kredensial Cloud API bila kanal WA dipakai.
