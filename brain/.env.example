# ── AutoOffice3D · THE BRAIN ─────────────────────────────────────────────
# Salin ke .env lalu isi. Semua driver bersifat opsional:
# kosong = mode offline (stub LLM / in-memory vector / local sandbox).

# Realtime
PORT=4800
SOCKET_PATH=/brain-server

# ── LLM (Production: Anthropic Claude 3.5 Sonnet) ───────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-3-5-sonnet-latest
# Kosongkan ANTHROPIC_API_KEY untuk memakai driver stub deterministik.
LLM_DRIVER=stub

# ── Embeddings + Vector Memory (Production: Pinecone Serverless) ─────────
# OPENAI_API_KEY=sk-...
# PINECONE_API_KEY=...
# PINECONE_HOST=https://your-index-project.pinecone.io
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_DRIVER=memory

# ── Code sandbox (Production: E2B micro-VM) ──────────────────────────────
# E2B_API_KEY=...
SANDBOX_DRIVER=local
SANDBOX_TIMEOUT_MS=60000

# ── Guardrails ───────────────────────────────────────────────────────────
MAX_ITERATIONS=5
TOKEN_BUDGET=250000

# ── Integrasi (Fase 4 — diisi nanti) ─────────────────────────────────────
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# STRIPE_WEBHOOK_SECRET=
# TWITTER_BEARER_TOKEN=
