# ── AutoOffice3D · THE BRAIN ─────────────────────────────────────────────
# Salin ke .env lalu isi. Semua driver bersifat opsional:
# kosong = mode offline (stub LLM / LanceDB local / local sandbox).

# Realtime
PORT=4800
SOCKET_PATH=/brain-server

# ── Durability (PRD v3.0 §2.1) ───────────────────────────────────────────
# Satu folder untuk seluruh state durable: lancedb/ (vector memory) + office.db
# (checkpoint LangGraph, run history, event log). Saat pindah VPS → mount jadi volume.
DATA_DIR=./data

# ── LLM (Production: Anthropic-compatible API) ───────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-3-5-sonnet-latest
# Base URL override — gateway lokal 9router atau API resmi Anthropic:
# ANTHROPIC_BASE_URL=http://localhost:20128/v1
# Kosongkan ANTHROPIC_API_KEY untuk memakai driver stub deterministik.
LLM_DRIVER=auto

# ── Embeddings + Vector Memory ───────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:20128/v1
# MEMORY_DRIVER: auto → pinecone bila key ada, jika tidak lancedb (durable, embedded).
# MEMORY_DRIVER=memory   # paksa in-process (dev/test, tidak durable)
MEMORY_DRIVER=auto
EMBEDDING_MODEL=text-embedding-3-small
# PINECONE_API_KEY=...
# PINECONE_HOST=https://your-index-project.pinecone.io

# ── Code sandbox (Production: E2B micro-VM) ──────────────────────────────
# E2B_API_KEY=...
SANDBOX_DRIVER=local
SANDBOX_TIMEOUT_MS=60000

# ── Guardrails ───────────────────────────────────────────────────────────
MAX_ITERATIONS=5
TOKEN_BUDGET=250000

# ── Integrasi (env-gated — kosong = driver offline) ──────────────────────
# Override driver bila perlu (default: auto sesuai token yang tersedia):
# DEPLOY_DRIVER=vercel     # local (default) | vercel | docker
#   docker → harness demo Fase 10: build image dari bundle codegen + preset
#            stack, spin up container di network `demo-net`, health probe
#            sebelum READY. `auto` tidak pernah memilih docker (env-gated).
# DEMO publish/probe (dipakai driver docker; default loopback host):
# DEPLOY_PUBLISH_HOST=127.0.0.1   # compose office stack: 0.0.0.0
# DEPLOY_PROBE_HOST=127.0.0.1     # compose office stack: host.docker.internal
# EMAIL_DRIVER=resend      # stub (default)  | resend
# SOCIAL_DRIVER=live       # stub (default)  | live  → butuh X_BEARER_TOKEN
# Catatan: memaksa driver live tanpa kredensial = error saat boot (fail fast),
# bukan fallback diam-diam. Integrasi Threads belum tersedia (dilewati).
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# X_BEARER_TOKEN=
# THREADS_ACCESS_TOKEN=
# RESEND_API_KEY=

# ── Payment Sentinel multi-provider (PRD §3.4/§8 — Fase 9) ───────────────
# PAYMENT_DRIVER: auto (default) → midtrans bila MIDTRANS_SERVER_KEY ada,
# selain itu stripe bila STRIPE_WEBHOOK_SECRET ada, selain itu stub (demo lokal).
#   stub     → halaman /demo/checkout + /demo/pay (tanpa akun gateway)
#   stripe   → webhook HMAC SHA-256 + Payment Links (butuh STRIPE_SECRET_KEY)
#   midtrans → Snap hosted page + notifikasi SHA-512 (market Indonesia)
#   xendit   → kerangka interface, implementasi menyusul (Fase 11)
# PAYMENT_DRIVER=auto
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_live_...        # hanya untuk membuat Payment Link
# MIDTRANS_SERVER_KEY=SB-Mid-server-...
# MIDTRANS_ENV=sandbox                 # sandbox | production
# XENDIT_SECRET_KEY=xnd_...

# ── TLS untuk produksi VPS (opsional — WSS di belakang Caddy) ───────────
# BRAIN_TLS_CERT=/path/to/cert.pem
# BRAIN_TLS_KEY=/path/to/key.pem
