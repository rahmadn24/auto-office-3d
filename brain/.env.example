# ── AutoOffice3D · THE BRAIN ─────────────────────────────────────────────
# Salin ke .env lalu isi. Semua driver bersifat opsional:
# kosong = mode offline (stub LLM / LanceDB local / local sandbox).

# Realtime
PORT=4800
SOCKET_PATH=/brain-server

# ── Durability (PRD v3.0 §2.1) ───────────────────────────────────────────
# Satu folder untuk seluruh state durable: lancedb/ (vector memory) + office.db
# (checkpoint LangGraph, run history, event log). Saat pindah VPS → mount jadi volume.
DATA_DIR=./data

# ── LLM (Production: Anthropic-compatible API) ───────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-3-5-sonnet-latest
# Base URL override — gateway lokal 9router atau API resmi Anthropic:
# ANTHROPIC_BASE_URL=http://localhost:20128/v1
# Kosongkan ANTHROPIC_API_KEY untuk memakai driver stub deterministik.
LLM_DRIVER=auto
# Fase 13 — provider murah ber-format OpenAI chat completions (DeepSeek, Groq,
# OpenRouter, 9router). Key terpisah dari OPENAI_API_KEY embeddings!
# OPENAI_COMPAT_API_KEY=sk-...
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1   # atau http://localhost:20128/v1
# OPENAI_COMPAT_MODEL=gpt-4o-mini                    # mis. oc/deepseek-v4.1-flash-free
#
# Fase 13+ — routing model per task (opsional). Kosong = pakai OPENAI_COMPAT_MODEL.
# Contoh 9router: PM (prd/briefing/brief) → GLM, Dev (code) → DeepSeek 4.1,
# CS → MiMo. Isi dengan id persis dari `GET /v1/models` gateway (model gratis
# opencode memakai prefix `oc/…-free`).
# OPENAI_COMPAT_MODEL_PRD=oc/glm-5.3-flash-free
# OPENAI_COMPAT_MODEL_BRIEFING=oc/glm-5.3-flash-free
# OPENAI_COMPAT_MODEL_BRIEF=oc/glm-5.3-flash-free
# OPENAI_COMPAT_MODEL_CODE=oc/deepseek-v4.1-flash-free
# OPENAI_COMPAT_MODEL_CS=oc/mimo-v2.6-flash-free

# ── Embeddings + Vector Memory ───────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:20128/v1
# MEMORY_DRIVER: auto → pinecone bila key ada, jika tidak lancedb (durable, embedded).
# MEMORY_DRIVER=memory   # paksa in-process (dev/test, tidak durable)
MEMORY_DRIVER=auto
EMBEDDING_MODEL=text-embedding-3-small
# PINECONE_API_KEY=...
# PINECONE_HOST=https://your-index-project.pinecone.io

# ── Code sandbox (Production: E2B micro-VM) ──────────────────────────────
# E2B_API_KEY=...
SANDBOX_DRIVER=local
SANDBOX_TIMEOUT_MS=60000

# ── Guardrails ───────────────────────────────────────────────────────────
MAX_ITERATIONS=5
TOKEN_BUDGET=250000
# Fase 13 — budget token harian lintas-run (0 = nonaktif). Run baru ditolak
# dengan pesan jelas bila habis; statusnya tampil di /health + Theater.
DAILY_TOKEN_BUDGET=2000000

# Fase 13 — hardening HTTP/socket:
# CORS_ORIGINS=https://office.example.com,https://cs.example.com  # default '*'
# WEBHOOK_MAX_BODY_BYTES=262144   # batas body webhook (byte), default 256 KiB

# ── Integrasi (env-gated — kosong = driver offline) ──────────────────────
# Override driver bila perlu (default: auto sesuai token yang tersedia):
# DEPLOY_DRIVER=vercel     # local (default) | vercel | docker
#   docker → harness demo Fase 10: build image dari bundle codegen + preset
#            stack, spin up container di network `demo-net`, health probe
#            sebelum READY. `auto` tidak pernah memilih docker (env-gated).
# DEMO publish/probe (dipakai driver docker; default loopback host):
# DEPLOY_PUBLISH_HOST=127.0.0.1   # compose office stack: 0.0.0.0
# DEPLOY_PROBE_HOST=127.0.0.1     # compose office stack: host.docker.internal
# EMAIL_DRIVER=resend      # stub (default)  | resend
# SOCIAL_DRIVER=live       # stub (default)  | live  → butuh X_BEARER_TOKEN
# Catatan: memaksa driver live tanpa kredensial = error saat boot (fail fast),
# bukan fallback diam-diam. Integrasi Threads belum tersedia (dilewati).
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# X_BEARER_TOKEN=
# THREADS_ACCESS_TOKEN=
# RESEND_API_KEY=

# ── Payment Sentinel multi-provider (PRD §3.4/§8 — Fase 9) ───────────────
# PAYMENT_DRIVER: auto (default) → midtrans bila MIDTRANS_SERVER_KEY ada,
# selain itu stripe bila STRIPE_WEBHOOK_SECRET ada, selain itu stub (demo lokal).
#   stub     → halaman /demo/checkout + /demo/pay (tanpa akun gateway)
#   stripe   → webhook HMAC SHA-256 + Payment Links (butuh STRIPE_SECRET_KEY)
#   midtrans → Snap hosted page + notifikasi SHA-512 (market Indonesia)
#   xendit   → kerangka interface, implementasi menyusul (Fase 11)
# PAYMENT_DRIVER=auto
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_live_...        # hanya untuk membuat Payment Link
# MIDTRANS_SERVER_KEY=SB-Mid-server-...
# MIDTRANS_ENV=sandbox                 # sandbox | production
# XENDIT_SECRET_KEY=xnd_...

# ── CS Agent: omnichannel inbox + closing (PRD §3.5 — Fase 11) ──────────
# WHATSAPP_DRIVER: auto (default) → live bila ketiga kredensial Cloud API ada,
# selain itu stub (pesan tercatat di log, tanpa kirim nyata).
#   stub → inbound webhook + outbound tercatat; guard jendela 24 jam tetap diuji
#   live → POST graph.facebook.com/{phoneNumberId}/messages (teks/template HSM)
# WHATSAPP_DRIVER=auto
# WHATSAPP_ACCESS_TOKEN=EAAG...        # Meta Cloud API token
# WHATSAPP_PHONE_NUMBER_ID=1234567890  # id nomor pengirim
# WHATSAPP_VERIFY_TOKEN=rahasia-demo   # dipakai verifikasi GET /webhook/whatsapp
# WHATSAPP_TEMPLATE_NAME=hello_world   # template HSM di luar jendela 24 jam
# Secret webhook email inbound (header `x-cs-inbound-secret`; kosong = mode demo):
# EMAIL_INBOUND_SECRET=
# Follow-up engine + tautan kontrak:
#   CS_FOLLOWUP_MS=60000          # interval scheduler sweep (0 = matikan)
#   CS_FOLLOWUP_DELAY_MS=600000   # jeda follow-up pertama setelah kontak terakhir
#   CS_MAX_FOLLOWUPS=3            # lewat batas ini → lead ditandai lost
#   CS_PUBLIC_BASE_URL=http://localhost:4800   # basis URL kontrak PDF
#   CS_WIDGET_URL=http://localhost:4800        # widget di halaman produk deploy
# Endpoint Fase 11: /demo/widget (halaman demo + widget), /widget/* (aset),
# /webhook/whatsapp (GET verifikasi + POST pesan), /webhook/email (inbound),
# /cs/contracts/<lead>.pdf (kontrak hasil closing flow).

# ── TLS untuk produksi VPS (opsional — WSS di belakang Caddy) ───────────
# BRAIN_TLS_CERT=/path/to/cert.pem
# BRAIN_TLS_KEY=/path/to/key.pem

# ── Fase 12: operasional VPS — logging, notifikasi, auth, domain demo ───
# LOG_LEVEL: trace|debug|info|warn|error|fatal|silent (default info; JSON satu
# baris ke stdout — dibaca `docker logs`/journalctl saat soak).
# LOG_LEVEL=info
# Notifikasi founder (milestone sale, deploy ready/degraded, run gagal,
# circuit breaker). NOTIFY_DRIVER=auto → telegram bila token+chat ada,
# selain itu discord bila webhook ada, selain itu stub (hanya catat).
# NOTIFY_DRIVER=auto
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Token operator (wajib di VPS): aksi privileged (kontrol run, founder,
# CS inbox/quote) butuh token; koneksi tanpa token hanya kanal widget publik.
# Kosongkan hanya untuk dev lokal/e2e.
# BRAIN_AUTH_TOKEN=token-panjang-acak
# Domain dasar demo publik → Brain memasang label caddy-docker-proxy pada
# container demo (demo.<slug>.<domain>); kosong = hanya mapping port host.
# DEMO_BASE_DOMAIN=demo.example.com

# ── Backup DATA_DIR (Fase 12) ───────────────────────────────────────────
# Jalankan dari root repo (cron VPS):
#   17 3 * * * cd /opt/autooffice3d && node scripts/backup.mjs --keep 14 >> logs/backup.log 2>&1
# Restore: node scripts/backup.mjs --restore <arsip> --target <folder>
# BACKUP_DIR=/opt/autooffice3d/backups   # default: <DATA_DIR>/../backups
